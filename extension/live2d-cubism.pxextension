{
  "format": "PrismatiXExtension",
  "schemaRevision": 2,
  "language": "typescript",
  "id": "live2d-cubism",
  "version": "0.1.0",
  "requiredEngineVersion": ">=0.1.0 <0.2.0",
  "entry": "main.ts",
  "capabilities": [
    "runtime",
    "persistence",
    "raw.mesh",
    "native"
  ],
  "platforms": [
    "win32-x64",
    "linux-x64",
    "darwin-x64",
    "darwin-arm64",
    "android-arm64"
  ],
  "safety": {
    "previewSafe": false,
    "deterministic": true,
    "seekSafe": true,
    "rollbackSafe": true
  },
  "native": {
    "abi": 1,
    "services": [
      "live2d.core.load",
      "live2d.model.create",
      "live2d.model.update",
      "live2d.model.release"
    ],
    "libraries": {
      "win32-x64": {
        "path": "native/win32-x64/px_live2d.dll",
        "userFiles": [
          {
            "name": "Live2DCubismCore.dll",
            "hint": "Live2D's Cubism Core. Download the Cubism SDK for Native from live2d.com; the file is Core/dll/windows/x86_64/Live2DCubismCore.dll. Live2D's license applies: read it before you ship a game with Core."
          }
        ]
      },
      "linux-x64": {
        "path": "native/linux-x64/libpx_live2d.so",
        "userFiles": [
          {
            "name": "libLive2DCubismCore.so",
            "hint": "Live2D's Cubism Core. Download the Cubism SDK for Native from live2d.com; the file is Core/dll/linux/x86_64/libLive2DCubismCore.so. Live2D's license applies: read it before you ship a game with Core."
          }
        ]
      },
      "darwin-x64": {
        "path": "native/darwin-x64/libpx_live2d.dylib",
        "userFiles": [
          {
            "name": "libLive2DCubismCore.dylib",
            "hint": "Live2D's Cubism Core. Download the Cubism SDK for Native from live2d.com; the file is Core/dll/macos/libLive2DCubismCore.dylib. Live2D's license applies: read it before you ship a game with Core."
          }
        ]
      },
      "darwin-arm64": {
        "path": "native/darwin-arm64/libpx_live2d.dylib",
        "userFiles": [
          {
            "name": "libLive2DCubismCore.dylib",
            "hint": "Live2D's Cubism Core. Download the Cubism SDK for Native from live2d.com; the file is Core/dll/macos/libLive2DCubismCore.dylib. Live2D's license applies: read it before you ship a game with Core."
          }
        ]
      },
      "android-arm64": {
        "path": "native/android-arm64/libpx_live2d.so",
        "userFiles": [
          {
            "name": "libLive2DCubismCore.so",
            "hint": "Live2D's Cubism Core. Download the Cubism SDK for Native from live2d.com; the file is Core/dll/android/arm64-v8a/libLive2DCubismCore.so. Live2D's license applies: read it before you ship a game with Core."
          }
        ]
      }
    }
  },
  "commands": [
    {
      "id": "live2d.core",
      "displayName": "Set Cubism Core",
      "description": "Where Live2D's Cubism Core library is. Leave the path empty to use the Core that pack and run copy beside the plugin from the project's NativeUserFiles/.",
      "category": "Live2D",
      "await": false,
      "rollback": "reversible",
      "parameters": [
        {
          "name": "path",
          "type": "string",
          "displayName": "path",
          "description": "Absolute path of Live2D's Cubism Core library, to override the one beside the plugin. Empty looks beside the plugin first, then uses the platform's default name.",
          "default": ""
        }
      ]
    },
    {
      "id": "live2d.show",
      "displayName": "Show Model",
      "description": "Shows a Live2D model, or replaces the one with this id.",
      "category": "Live2D",
      "await": false,
      "rollback": "reversible",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "displayName": "id",
          "description": "Name you use to refer to the model later.",
          "required": true
        },
        {
          "name": "model",
          "type": "string",
          "displayName": "model",
          "description": "Project path of the .model3.json; its .moc3, textures, motions and expressions sit beside it.",
          "required": true,
          "optionsFrom": {
            "provider": "owenliu0924/live2d-cubism:models"
          }
        },
        {
          "name": "x",
          "type": "number",
          "displayName": "x",
          "description": "Horizontal position of the model's feet, as a fraction of the screen width.",
          "default": 0.5,
          "range": {
            "minimum": -2,
            "maximum": 3,
            "step": 0.01
          }
        },
        {
          "name": "y",
          "type": "number",
          "displayName": "y",
          "description": "Vertical position of the model's feet, as a fraction of the screen height.",
          "default": 1,
          "range": {
            "minimum": -2,
            "maximum": 3,
            "step": 0.01
          }
        },
        {
          "name": "height",
          "type": "number",
          "displayName": "height",
          "description": "Height of the model's canvas, as a fraction of the screen height.",
          "default": 1,
          "range": {
            "minimum": 0.05,
            "maximum": 5,
            "step": 0.01
          }
        },
        {
          "name": "z",
          "type": "integer",
          "displayName": "z",
          "description": "Models with a higher z draw over lower ones.",
          "default": 0,
          "range": {
            "minimum": 0,
            "maximum": 100
          }
        },
        {
          "name": "idle",
          "type": "string",
          "displayName": "idle",
          "description": "Motion group looped while nothing else plays (empty for none).",
          "default": "Idle",
          "optionsFrom": {
            "provider": "owenliu0924/live2d-cubism:motions"
          }
        },
        {
          "name": "breath",
          "type": "boolean",
          "displayName": "breath",
          "description": "Add Cubism's breathing sway.",
          "default": true
        },
        {
          "name": "blink",
          "type": "boolean",
          "displayName": "blink",
          "description": "Blink using the model's EyeBlink group.",
          "default": true
        }
      ]
    },
    {
      "id": "live2d.hide",
      "displayName": "Hide Model",
      "description": "Removes a model.",
      "category": "Live2D",
      "await": false,
      "rollback": "reversible",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "displayName": "id",
          "description": "",
          "required": true
        }
      ]
    },
    {
      "id": "live2d.move",
      "displayName": "Move Model",
      "description": "Moves and resizes a shown model.",
      "category": "Live2D",
      "await": false,
      "rollback": "reversible",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "displayName": "id",
          "description": "",
          "required": true
        },
        {
          "name": "x",
          "type": "number",
          "displayName": "x",
          "description": "",
          "default": 0.5,
          "range": {
            "minimum": -2,
            "maximum": 3,
            "step": 0.01
          }
        },
        {
          "name": "y",
          "type": "number",
          "displayName": "y",
          "description": "",
          "default": 1,
          "range": {
            "minimum": -2,
            "maximum": 3,
            "step": 0.01
          }
        },
        {
          "name": "height",
          "type": "number",
          "displayName": "height",
          "description": "",
          "default": 1,
          "range": {
            "minimum": 0.05,
            "maximum": 5,
            "step": 0.01
          }
        }
      ]
    },
    {
      "id": "live2d.motion",
      "displayName": "Play Motion",
      "description": "Plays a motion of the model3.json; the idle motion resumes afterwards.",
      "category": "Live2D",
      "await": false,
      "rollback": "reversible",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "displayName": "id",
          "description": "",
          "required": true
        },
        {
          "name": "group",
          "type": "string",
          "displayName": "group",
          "description": "Motion group name, for example TapBody.",
          "required": true,
          "optionsFrom": {
            "provider": "owenliu0924/live2d-cubism:motions"
          }
        },
        {
          "name": "index",
          "type": "integer",
          "displayName": "index",
          "description": "Which motion of the group.",
          "default": 0,
          "range": {
            "minimum": 0,
            "maximum": 999
          }
        },
        {
          "name": "loop",
          "type": "boolean",
          "displayName": "loop",
          "description": "",
          "default": false
        }
      ]
    },
    {
      "id": "live2d.expression",
      "displayName": "Set Expression",
      "description": "Applies an expression of the model3.json by name; empty clears it.",
      "category": "Live2D",
      "await": false,
      "rollback": "reversible",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "displayName": "id",
          "description": "",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "displayName": "name",
          "description": "",
          "default": "",
          "optionsFrom": {
            "provider": "owenliu0924/live2d-cubism:expressions"
          }
        }
      ]
    },
    {
      "id": "live2d.param",
      "displayName": "Hold Parameter",
      "description": "Holds a parameter at a value (lip sync, looking somewhere), or lets go of it.",
      "category": "Live2D",
      "await": false,
      "rollback": "reversible",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "displayName": "id",
          "description": "",
          "required": true
        },
        {
          "name": "param",
          "type": "string",
          "displayName": "param",
          "description": "Parameter id, for example ParamMouthOpenY.",
          "required": true,
          "optionsFrom": {
            "provider": "owenliu0924/live2d-cubism:parameters"
          }
        },
        {
          "name": "value",
          "type": "number",
          "displayName": "value",
          "description": "",
          "default": 0
        },
        {
          "name": "release",
          "type": "boolean",
          "displayName": "release",
          "description": "Stop holding the parameter.",
          "default": false
        }
      ]
    }
  ],
  "actions": [],
  "studio": {
    "entry": "dist/studio.js",
    "requiredStudioVersion": ">=0.1.0",
    "permissions": [
      "project.read"
    ],
    "contributes": {
      "assetTypes": [
        {
          "id": "live2d.model",
          "displayName": "Live2D model",
          "description": "A Live2D Cubism model: the .model3.json that names its .moc3, textures, motions and expressions.",
          "patterns": [
            "*.model3.json"
          ]
        }
      ],
      "inspectors": [
        {
          "assetType": "live2d.model",
          "displayName": "Live2D model",
          "description": "The model's files, motions, expressions and parameters, and whether Cubism Core is in NativeUserFiles/."
        }
      ],
      "parameterOptions": [
        {
          "id": "models",
          "displayName": "Live2D models",
          "description": "The project's .model3.json files."
        },
        {
          "id": "motions",
          "displayName": "Motion groups",
          "description": "Motion groups of the model shown with this id (or of every model when that cannot be told)."
        },
        {
          "id": "expressions",
          "displayName": "Expressions",
          "description": "Expressions of the model shown with this id (or of every model)."
        },
        {
          "id": "parameters",
          "displayName": "Parameters",
          "description": "Parameter ids from the model's cdi3.json, or the ones its motions and expressions use."
        }
      ]
    }
  }
}
